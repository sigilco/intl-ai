{
  "name": "@intl-ai/expo",
  "version": "0.6.0",
  "description": "Expo config plugin: runs the intl-ai binary during prebuild",
  "keywords": [
    "ai",
    "expo",
    "i18n",
    "intl",
    "react-native",
    "translation"
  ],
  "homepage": "https://intl-ai.pages.dev",
  "bugs": "https://github.com/sigilco/intl-ai/issues",
  "license": "Apache-2.0",
  "author": "Joaquin Terrasa",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sigilco/intl-ai.git"
  },
  "files": [
    "dist",
    "app.plugin.js",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.mts",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@expo/config-plugins": ">=7.0.0",
    "@intl-ai/unplugin": "workspace:*",
    "intl-ai": ">=0.5.0 <1.0.0"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "^22.18.0 || >=24"
  }
}
