{
  "name": "@intl-ai/unplugin",
  "version": "0.7.0",
  "description": "AI-powered i18n translation plugin for all bundlers (runs the intl-ai binary)",
  "keywords": [
    "ai",
    "esbuild",
    "i18n",
    "intl",
    "rollup",
    "translation",
    "unplugin",
    "vite",
    "webpack"
  ],
  "homepage": "https://intl-ai.illo.fyi",
  "bugs": "https://github.com/sigilco/intl-ai/issues",
  "license": "Apache-2.0",
  "author": "Joaquin Terrasa",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sigilco/intl-ai.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./vite": {
      "import": "./dist/vite.mjs",
      "types": "./dist/vite.d.mts",
      "default": "./dist/vite.mjs",
      "require": "./dist/vite.cjs"
    },
    "./rollup": {
      "import": "./dist/rollup.mjs",
      "types": "./dist/rollup.d.mts",
      "default": "./dist/rollup.mjs",
      "require": "./dist/rollup.cjs"
    },
    "./webpack": {
      "import": "./dist/webpack.mjs",
      "types": "./dist/webpack.d.mts",
      "default": "./dist/webpack.mjs",
      "require": "./dist/webpack.cjs"
    },
    "./esbuild": {
      "import": "./dist/esbuild.mjs",
      "types": "./dist/esbuild.d.mts",
      "default": "./dist/esbuild.mjs",
      "require": "./dist/esbuild.cjs"
    },
    "./rspack": {
      "import": "./dist/rspack.mjs",
      "types": "./dist/rspack.d.mts",
      "default": "./dist/rspack.mjs",
      "require": "./dist/rspack.cjs"
    },
    "./rolldown": {
      "import": "./dist/rolldown.mjs",
      "types": "./dist/rolldown.d.mts",
      "default": "./dist/rolldown.mjs",
      "require": "./dist/rolldown.cjs"
    },
    "./farm": {
      "import": "./dist/farm.mjs",
      "types": "./dist/farm.d.mts",
      "default": "./dist/farm.mjs",
      "require": "./dist/farm.cjs"
    },
    "./bun": {
      "import": "./dist/bun.mjs",
      "types": "./dist/bun.d.mts",
      "default": "./dist/bun.mjs",
      "require": "./dist/bun.cjs"
    },
    "./runner": {
      "import": "./dist/runner.mjs",
      "types": "./dist/runner.d.mts",
      "require": "./dist/runner.cjs",
      "default": "./dist/runner.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "intl-ai": ">=0.5.0 <1.0.0",
    "unplugin": "catalog:"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@farmfe/core": ">=1.0.0",
    "@rspack/core": ">=2.1.1",
    "esbuild": ">=0.18.0",
    "rolldown": ">=1.0.0",
    "rollup": ">=3.0.0",
    "vite": ">=5.0.0",
    "webpack": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    },
    "rollup": {
      "optional": true
    },
    "webpack": {
      "optional": true
    },
    "esbuild": {
      "optional": true
    },
    "@rspack/core": {
      "optional": true
    },
    "rolldown": {
      "optional": true
    },
    "@farmfe/core": {
      "optional": true
    }
  },
  "engines": {
    "node": "^22.18.0 || >=24"
  }
}
