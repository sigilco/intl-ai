{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "lint": {},
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "schema:build": {
      "outputs": ["src/schema/intl-ai.schema.json"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "publish:local": {
      "dependsOn": ["build"],
      "cache": false
    }
  }
}
